{
  "expo": {
    "name": "ShikshaSetu",
    "slug": "shikshasetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shikshasetu",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.starkdynamics.shikshasetu"
    },
    "android": {
      "package": "com.starkdynamics.shikshasetu",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-sqlite",
      [
        "react-native-vosk",
        {
          "models": [
            "./assets/model-hi-in"
          ]
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "0625977c-18a7-45fe-8a80-b2ab47973c41"
      }
    }
  }
}
